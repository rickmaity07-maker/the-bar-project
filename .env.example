# Copy to .env.local (and add the same variable in Vercel) for the admin portal and reservations.
#
# Neon Postgres connection string: Neon console -> your project -> Connect.
# Without it the public site still works from its built-in menu and hours,
# but reservations cannot be stored and /login is unavailable.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Then create the tables and the first owner account:
#   npm run db:setup -- owner@example.com "a-long-password"
# Everyone signs in at /login. Accounts with the owner role are sent to /admin,
# where the owner can promote other accounts.

# --- Email notification for new bookings (same setup as the Atlantic site) ---
# Free: no domain, DNS records or paid email service needed.
# A Gmail account with 2-Step Verification and an App Password from
# myaccount.google.com/apppasswords (not the normal Gmail password).
GMAIL_USER=your.account@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
GMAIL_FROM_NAME=Bar-05
# Where new booking requests are sent. Several addresses: separate with commas.
RESERVATION_NOTIFY_EMAIL=inhaber@example.com
# Optional: another mail server instead of Gmail, with the same user and password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# --- Google sign-in (free) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorized redirect URIs:
#   https://the-bar-project.vercel.app/api/auth/google/callback
#   http://localhost:3001/api/auth/google/callback
# The "Mit Google anmelden" button appears once both values are set.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
