{
  "name": "atlantic-undertow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-content.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/nodemailer": "^8.0.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "imapflow": "^2.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
